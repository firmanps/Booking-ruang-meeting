generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  ADMIN
}

enum Status {
  CONFIRMED
  CANCELLED
}

model Users {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(100)
  password   String   @db.VarChar(255)
  role       Role     @default(EMPLOYEE)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  bookings Bookings[] @relation("UserBookings")

  @@map("users")
}

model Rooms {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(100)
  capacity   Int
  facilities String   @db.Text
  locations  String   @db.Text
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  bookings Bookings[]

  @@map("rooms")
}

model Bookings {
  id           String    @id @default(uuid())
  room_id      String
  user_id      String
  title        String    @db.VarChar(50)
  start_at     DateTime  @db.Timestamptz(3) 
  end_at       DateTime  @db.Timestamptz(3) 
  status       Status    @default(CONFIRMED)
  cancelled_at DateTime? @db.Timestamptz(3)
  cancelled_by String?
  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  updated_at   DateTime  @updatedAt @db.Timestamptz(3)

  user  Users @relation("UserBookings", fields: [user_id], references: [id], onDelete: Cascade)
  rooms Rooms @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@index([room_id, start_at, end_at])
  @@index([user_id])
  @@map("bookings")
}
