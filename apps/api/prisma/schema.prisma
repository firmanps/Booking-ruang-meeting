generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  ADMIN
}

enum Status {
  CONFIRMED
  CANCELLED
}

model Users {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(100)
  password   String   @db.VarChar(255)
  role       Role     @default(EMPLOYEE)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings Bookings[] @relation("UserBookings")

  @@map("users")
}

model Rooms {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(100)
  capacity   Int
  facilities String   @db.Text
  locations  String   @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings Bookings[]

  @@map("rooms")
}

model Bookings {
  id           String    @id @default(uuid())
  roomId       String    @map("room_id")
  userId       String    @map("user_id")
  title        String    @db.VarChar(50)
  startAt      DateTime  @map("start_at") @db.Timestamptz(3)
  endAt        DateTime  @map("end_at") @db.Timestamptz(3)
  status       Status    @default(CONFIRMED)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy  String?   @map("cancelled_by")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  Users @relation("UserBookings", fields: [userId], references: [id], onDelete: Cascade)
  rooms Rooms @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startAt, endAt])
  @@index([userId])
  @@map("bookings")
}
